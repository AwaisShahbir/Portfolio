{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firestore-debug.log"
    ]
  },
  "hosting": {
    "site": "portfolio-a63a3",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|webp|png|jpg|jpeg|gif|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/token",
        "function": {
          "codebase": "default",
          "id": "getLiveKitToken"
        }
      },
      {
        "source": "/api/notify-contact",
        "function": {
          "codebase": "default",
          "id": "notifyContactRequest"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}