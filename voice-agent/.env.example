# LiveKit Project Credentials (from https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# OpenAI API Key (Required for default brain, VAD, STT, and TTS)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google Gemini API Settings (Alternative Brain)
USE_GEMINI=false
GEMINI_API_KEY=AIzaSyYourGeminiApiKey

# Optional: Deepgram API Key (For ultra-low latency Speech-to-Text)
DEEPGRAM_API_KEY=your-deepgram-api-key
